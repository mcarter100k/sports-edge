# Copy to .env (gitignored). The scheduled jobs read it on every run.
# Reference odds: https://the-odds-api.com (free plan: 500 credits/month)
ODDS_API_KEY=
# Where alerts go: your own iMessage number (+15551234567) or Apple ID email.
IMESSAGE_TO=
# free (500 credits/month: one check ~30 min before each kickoff cluster, soonest
# first until the day's credits are spent) or paid (checks 60 and 15 min before).
# ODDS_PLAN=free
# Optional overrides (defaults shown; ODDS_DAILY_CREDITS defaults to 15 free, 600 paid). Changing a shadow rule value relabels
# new ledger rows as GAP_v2+custom(...).
# ODDS_DAILY_CREDITS=15
# SHADOW_STAKE_DOLLARS=10
# ODDS_INTERVAL_MIN=60
# ODDS_HORIZON_H=24
# KALSHI_MAX_RPS=5
